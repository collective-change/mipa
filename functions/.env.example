# Copy to .env (or .env.<projectId>) before deploying.
UPDATE_EXCHANGE_RATES_REGION=us-central1
UPDATE_EXCHANGE_RATES_SCHEDULE=every 24 hours
UPDATE_EXCHANGE_RATES_TIME_ZONE=Etc/UTC

# Scheduled Firestore Backups (MIPA-34)
BACKUP_SCHEDULE="0 3 * * *"
BACKUP_TIME_ZONE=Etc/UTC
BACKUP_REGION=us-central1
BACKUP_BUCKET=mipa-2-firestore-backups
