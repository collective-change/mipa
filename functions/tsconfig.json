{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "skipLibCheck": true
  },
  "compileOnSave": true,
  "include": ["src"]
}
