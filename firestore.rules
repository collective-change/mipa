rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Matches any document in the 'tasks' collection or subcollections.
    match /tasks/{userId}/{document=**} {
      //allow read, write
      allow read, write: if request.auth.uid == userId;
    }

    match /adHocDocs/{document=**} {
      allow read: if request.auth.uid != null;
    }

    match /orgs/{org} {
      // A new organization starts with its creator as the only member and admin.
      allow create: if request.auth != null
        && request.resource.data.users == [request.auth.uid]
        && request.resource.data.superAdmins == [request.auth.uid];
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      // Members may edit the organization; only admins may change who is in it.
      // (Joining, leaving and role changes go through Cloud Functions.)
      allow update: if request.auth != null && request.auth.uid in resource.data.users
        && (request.auth.uid in resource.data.superAdmins
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["users", "superAdmins"]));
      allow delete: if request.auth != null && request.auth.uid in resource.data.superAdmins;

      // Name and email of each member, visible to the organization's members.
      // A member may write only their own entry.
      match /members/{memberId} {
        allow read: if userInOrg(org);
        allow create, update: if request.auth.uid == memberId && userInOrg(org);
        allow delete: if request.auth.uid == memberId || isOrgAdmin(org);
      }

      // Invitations: created and withdrawn by admins; the invited person can
      // see and decline theirs. Accepting goes through the acceptInvitation
      // Cloud Function, which needs a verified email.
      match /invitations/{invitationId} {
        allow read: if isOrgAdmin(org) || isInvitee(resource.data);
        allow create: if isOrgAdmin(org)
          && request.resource.data.email == request.resource.data.email.lower()
          && request.resource.data.role in ["member", "admin"]
          && request.resource.data.orgId == org
          && request.resource.data.invitedBy == request.auth.uid;
        allow delete: if isOrgAdmin(org) || isInvitee(resource.data);
      }
    }

    // Lets people find invitations addressed to them across organizations.
    match /{path=**}/invitations/{invitationId} {
      allow read: if isInvitee(resource.data);
    }

    // A model and its nodes. Its other subcollections, such as aiDrafts
    // (AI draft conversations), are written only by Cloud Functions.
    match /models/{model} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && request.auth.uid in resource.data.editors.users;
      allow delete: if request.auth != null && request.auth.uid in resource.data.owners.users;
      allow read: if resource.data.isPublic == true;
    
      // Match any document in a model's nodes collection
      match /nodes/{node} {
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/models/$(model)).data.editors.users;
      }
    }

    // AI provider settings: members see which provider and model are in use;
    // only Cloud Functions change them.
    match /orgAiSettings/{org} {
      allow read: if userInOrg(org);
    }

    // Encrypted API keys and provider credentials: no client may read or write.
    match /orgSecrets/{secret=**} {
      allow read, write: if false;
    }

    match /actions/{action}  {
      allow create: if userInOrg(request.resource.data.orgId);
      allow update: if userInOrg(resource.data.orgId) && userInOrg(request.resource.data.orgId);
      allow delete: if userInOrg(resource.data.orgId);
      allow read: if userInOrg(resource.data.orgId);
    }

    // Private profile; other members see the copy in orgs/{org}/members.
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    match /chats/{chatId} {
      allow create: if userInOrg(request.resource.data.orgId);
      allow read, update: if request.auth != null && request.auth.uid in resource.data.members;
      allow read, update: if request.auth != null
        && resource.data.membersOnly == false
        && userInOrg(resource.data.orgId);
    }

    function isOrgAdmin(orgId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/orgs/$(orgId)).data.superAdmins;
    }

    function isInvitee(invitation) {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == invitation.email;
    }

    function userInOrg(orgId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/orgs/$(orgId)).data.users;
    }

  }
}