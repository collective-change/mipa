rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Matches any document in the 'tasks' collection or subcollections.
    match /tasks/{userId}/{document=**} {
      //allow read, write
      allow read, write: if request.auth.uid == userId;
    }

    match /adHocDocs/{document=**} {
      allow read: if request.auth.uid != null;
    }

    match /orgs/{org} {
      // A new organization starts with its creator as the only member and admin.
      allow create: if request.auth != null
        && request.resource.data.users == [request.auth.uid]
        && request.resource.data.superAdmins == [request.auth.uid];
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      // Members may edit the organization; only admins may change who is in it.
      // (Joining, leaving and role changes go through Cloud Functions.)
      allow update: if request.auth != null && request.auth.uid in resource.data.users
        && (request.auth.uid in resource.data.superAdmins
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["users", "superAdmins"]));
      allow delete: if request.auth != null && request.auth.uid in resource.data.superAdmins;

      // Name and email of each member, visible to the organization's members.
      // A member may write only their own entry.
      match /members/{memberId} {
        allow read: if userInOrg(org);
        allow create, update: if request.auth.uid == memberId && userInOrg(org);
        allow delete: if request.auth.uid == memberId || isOrgAdmin(org);
      }

      // Invitations: created and withdrawn by admins; the invited person can
      // see and decline theirs. Accepting goes through the acceptInvitation
      // Cloud Function, which needs a verified email.
      match /invitations/{invitationId} {
        allow read: if isOrgAdmin(org) || isInvitee(resource.data);
        allow create: if isOrgAdmin(org)
          && request.resource.data.email == request.resource.data.email.lower()
          && request.resource.data.role in ["member", "admin"]
          && request.resource.data.orgId == org
          && request.resource.data.invitedBy == request.auth.uid;
        allow delete: if isOrgAdmin(org) || isInvitee(resource.data);
      }

      // Automated reviews (MIPA-43). Written once, only by Cloud Functions,
      // with the model and methodology version that produced them; never
      // edited, so an old review keeps the version it used.
      match /reviews/{reviewId} {
        allow read: if userInOrg(org);
        allow write: if false;
      }
    }

    // Lets people find invitations addressed to them across organizations.
    match /{path=**}/invitations/{invitationId} {
      allow read: if isInvitee(resource.data);
    }

    // A model and its nodes. Its other subcollections, such as aiDrafts
    // (AI draft conversations), are written only by Cloud Functions.
    match /models/{model} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (request.auth.uid in resource.data.editors.users || isModelViewer(resource.data));
      allow read: if resource.data.isPublic == true;
      allow update: if request.auth != null && request.auth.uid in resource.data.editors.users;
      allow delete: if request.auth != null && request.auth.uid in resource.data.owners.users;
    
      // Match any document in a model's nodes collection
      match /nodes/{node} {
        allow read: if (request.auth != null && (
            request.auth.uid in get(/databases/$(database)/documents/models/$(model)).data.editors.users
            || isModelViewer(get(/databases/$(database)/documents/models/$(model)).data)
          ))
          || get(/databases/$(database)/documents/models/$(model)).data.isPublic == true;
        allow write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/models/$(model)).data.editors.users;
      }

      // Immutable model snapshots for decision provenance & governance
      match /snapshots/{snapshot} {
        allow read: if request.auth != null && (
            request.auth.uid in get(/databases/$(database)/documents/models/$(model)).data.editors.users
            || isModelViewer(get(/databases/$(database)/documents/models/$(model)).data)
            || get(/databases/$(database)/documents/models/$(model)).data.isPublic == true
          );
        allow create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/models/$(model)).data.editors.users;
        allow update, delete: if false;
      }
    }

    // AI provider settings: members see which provider and model are in use;
    // only Cloud Functions change them.
    match /orgAiSettings/{org} {
      allow read: if userInOrg(org);
    }

    // Encrypted API keys and provider credentials: no client may read or write.
    match /orgSecrets/{secret=**} {
      allow read, write: if false;
    }

    // First-party cookieless telemetry events: written strictly via Admin SDK in Cloud Functions.
    // Closed to all direct browser reads and writes.
    match /telemetryEvents/{docId} {
      allow read, write: if false;
    }

    // Operator issue store (todo281): server-only subtree in mipa-2.
    // All writes go exclusively through the opsStoreManager Cloud Function write gate,
    // and no client (unauthenticated or signed-in user) may read or write ops/.
    match /ops/{document=**} {
      allow read, write: if false;
    }

    match /actions/{action}  {
      allow create: if userInOrg(request.resource.data.orgId);
      allow update: if userInOrg(resource.data.orgId) && userInOrg(request.resource.data.orgId);
      allow delete: if userInOrg(resource.data.orgId);
      allow read: if userInOrg(resource.data.orgId);
    }

    // Private profile; other members see the copy in orgs/{org}/members.
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    match /chats/{chatId} {
      allow create: if userInOrg(request.resource.data.orgId);
      allow read, update: if request.auth != null && request.auth.uid in resource.data.members;
      allow read, update: if request.auth != null
        && resource.data.membersOnly == false
        && userInOrg(resource.data.orgId);
    }

    function isOrgAdmin(orgId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/orgs/$(orgId)).data.superAdmins;
    }

    function isInvitee(invitation) {
      return request.auth != null
        && request.auth.token.email != null
        && (request.auth.token.email == invitation.email || request.auth.token.email.lower() == invitation.email);
    }

    function userInOrg(orgId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/orgs/$(orgId)).data.users;
    }

    function isModelViewer(modelData) {
      return request.auth != null && (
        ('viewers' in modelData && modelData.viewers != null && (
          ('users' in modelData.viewers && modelData.viewers.users != null && request.auth.uid in modelData.viewers.users)
          || ('emails' in modelData.viewers && modelData.viewers.emails != null && request.auth.token.email != null && request.auth.token.email.lower() in modelData.viewers.emails)
          || ('org' in modelData.viewers && modelData.viewers.org != null && (
            (modelData.viewers.org is string && userInOrg(modelData.viewers.org))
            || (modelData.viewers.org is list && (
              (modelData.viewers.org.size() > 0 && userInOrg(modelData.viewers.org[0]))
              || (modelData.viewers.org.size() > 1 && userInOrg(modelData.viewers.org[1]))
              || (modelData.viewers.org.size() > 2 && userInOrg(modelData.viewers.org[2]))
              || (modelData.viewers.org.size() > 3 && userInOrg(modelData.viewers.org[3]))
              || (modelData.viewers.org.size() > 4 && userInOrg(modelData.viewers.org[4]))
            ))
          ))
        ))
      );
    }

  }
}